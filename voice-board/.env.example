# Voice Board environment (template)
#
# AI is optional. If OPENAI_API_KEY is empty/unset, the app still works,
# but AI outputs (e.g. suggestedAnswer) will be null.

OPENAI_API_KEY=

# Known working default for the OpenAI SDK (can be changed later)
OPENAI_MODEL=gpt-4o-mini

# Optional: if your key is for an OpenAI-compatible gateway/proxy, set its base URL.
# Example: https://api.openai.com/v1
# OPENAI_BASE_URL=

# Optional dev/test switches:
# AI_MODE=mock
# AI_MODE=off
